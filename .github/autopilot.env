# Settings for https://github.com/Leo486597/autopilot. Shell syntax: bin/autopilot.sh sources this file.
# A line left out keeps the default shown in bin/autopilot.sh.
BASE=main                               # the branch PRs go into; also set it in triage.yml and judge.yml
NEEDS_LABEL="needs: owner"              # waits on the owner; must be in labels.yml
BUILDABLE='^kind: (feature|bug|chore)$' # a label matching this gets a worker
AT_ONCE=3                               # workers running together
CHECKS_WORKFLOW=                        # e.g. ci.yml: the judge waits for its run on the PR's commit
REQUIRED_CHECK=                         # e.g. "test": a check that must be green before a merge
REVIEW_LIST=                            # issue number where merged PRs wait for the owner's tick
BOARD_PROJECTS=                         # e.g. "1": project numbers whose Stage field the agents keep
MODEL=claude-opus-5-5
